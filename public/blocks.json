{
  "_readme": [
    "Blocks and items share ONE id space (same ids as index.html). Never reuse an id between blocks.json and items.json.",
    "type: stone | wood | plant | dirt | leaf | glass | liquid. It decides which item breakSpeed key applies (see typeRules).",
    "hardness: base mining difficulty. Break time (seconds) = max(0.06, hardness * 0.5 / speed). speed comes from the held item's breakSpeed for this block's type (1 = bare hand).",
    "hardness 0 = instant (plants). unbreakable = true means it cannot be mined in survival.",
    "drops: what you get when broken. null = nothing. requiresTool = only drops when that tool is held.",
    "textures: top / side / bottom tile names from the texture atlas. hidden = true hides it from the creative inventory.",
    "maxStack: how many fit in one inventory slot."
  ],
  "settings": {
    "maxStackDefault": 999
  },
  "typeRules": {
    "stone": {
      "breakSpeedKey": "stone",
      "bestTool": "pickaxe"
    },
    "wood": {
      "breakSpeedKey": "wood",
      "bestTool": "axe"
    },
    "plant": {
      "breakSpeedKey": "plant",
      "bestTool": null
    },
    "dirt": {
      "breakSpeedKey": "dirt",
      "bestTool": "shovel"
    },
    "leaf": {
      "breakSpeedKey": "leaf",
      "bestTool": "shears"
    },
    "glass": {
      "breakSpeedKey": "normal",
      "bestTool": null
    },
    "liquid": {
      "breakSpeedKey": "normal",
      "bestTool": null
    }
  },
